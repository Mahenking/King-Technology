#!/bin/bash
# ============================================================
# 👑 King OS Repository Builder (Multi-Version, Multi-Source)
# ============================================================
# Reads packages.txt (names only), finds every version across
# all enabled sources in config/sources.conf, converts each to
# .kpk, keeps 3 newest versions, updates index.json, pushes.
# ============================================================

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$REPO_ROOT/config/repo.conf"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "❌ Config not found. Run ./setup.sh first."
    exit 1
fi
source "$CONFIG_FILE"

SOURCES_TXT="$REPO_ROOT/sources.txt"
FIND_URLS="$REPO_ROOT/scraper/find-package-urls.sh"
METADATA_DIR="$TEMP_DIR/metadata"

KEEP_VERSIONS=3

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; PURPLE='\033[0;35m'; CYAN='\033[0;36m'; NC='\033[0m'

mkdir -p "$PACKAGES_DIR"
mkdir -p "$TEMP_DIR"

echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo -e "${PURPLE}  👑 King OS Repository Builder${NC}"
echo -e "${PURPLE}  Multi-Version • Multi-Source • Keep $KEEP_VERSIONS newest${NC}"
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo ""

for tool in python3 wget ar tar zstd git curl; do
    command -v $tool &> /dev/null || { echo -e "${RED}❌ Missing: $tool${NC}"; exit 1; }
done

[ -f "$PACKAGES_LIST" ] || { echo -e "${RED}❌ packages.txt not found${NC}"; exit 1; }
[ -x "$FIND_URLS" ]     || { echo -e "${RED}❌ $FIND_URLS not executable${NC}"; exit 1; }

PACKAGES=()
while IFS= read -r line; do
    [[ "$line" =~ ^#.*$ ]] && continue
    [[ -z "$line" ]] && continue
    PACKAGES+=("$(echo "$line" | tr -d '[:space:]')")
done < "$PACKAGES_LIST"

echo -e "${CYAN}📦 ${#PACKAGES[@]} package names to process${NC}"
echo -e "${CYAN}📚 Keeping $KEEP_VERSIONS newest versions per package${NC}"
echo ""

[ ${#PACKAGES[@]} -eq 0 ] && { echo -e "${YELLOW}⚠️  Empty packages.txt${NC}"; exit 0; }

[ ! -f "$INDEX_FILE" ] && echo '{"version":"1.0","generated":"","packages":{}}' > "$INDEX_FILE"

echo "# Auto-generated by king-repo-build.sh on $(date)" > "$SOURCES_TXT"

# ============================================================
# Helpers
# ============================================================
download_and_convert() {
    # $1 = URL, $2 = pkg name
    local URL="$1" PKG="$2"
    local FILENAME DOWNLOAD_PATH CONTROL_ARCHIVE
    local PKG_NAME PKG_VERSION PKG_ARCH PKG_DEPENDS_RAW PKG_DESC PKG_DEPENDS
    local EXTRACT_DIR KPK_FILENAME KPK_PATH KPK_SIZE KPK_SHA256

    FILENAME=$(basename "$URL")
    DOWNLOAD_PATH="$TEMP_DIR/$FILENAME"

    echo -e "${BLUE}   ⬇️  $FILENAME${NC}"
    if ! wget -q -O "$DOWNLOAD_PATH" "$URL"; then
        echo -e "${RED}   ❌ Download failed${NC}"
        return 1
    fi

    rm -rf "$METADATA_DIR"; mkdir -p "$METADATA_DIR"
    ( cd "$METADATA_DIR" && ar x "$DOWNLOAD_PATH" 2>/dev/null ) || return 1

    CONTROL_ARCHIVE=""
    for f in "$METADATA_DIR"/control.tar*; do
        [ -f "$f" ] && CONTROL_ARCHIVE="$f" && break
    done
    [ -z "$CONTROL_ARCHIVE" ] && { echo -e "${RED}   ❌ No control file${NC}"; return 1; }

    ( cd "$METADATA_DIR" && \
      case "$CONTROL_ARCHIVE" in
          *.gz)  tar -xzf "$CONTROL_ARCHIVE" ;;
          *.xz)  tar -xJf "$CONTROL_ARCHIVE" ;;
          *.zst) tar --use-compress-program=unzstd -xf "$CONTROL_ARCHIVE" ;;
          *)     tar -xf "$CONTROL_ARCHIVE" ;;
      esac ) || return 1

    PKG_NAME=$(grep "^Package:" "$METADATA_DIR/control" | cut -d' ' -f2- | tr -d '\r')
    PKG_VERSION=$(grep "^Version:" "$METADATA_DIR/control" | cut -d' ' -f2- | tr -d '\r')
    PKG_ARCH=$(grep "^Architecture:" "$METADATA_DIR/control" | cut -d' ' -f2- | tr -d '\r')
    PKG_DEPENDS_RAW=$(grep "^Depends:" "$METADATA_DIR/control" | cut -d' ' -f2- | tr -d '\r' || echo "")
    PKG_DESC=$(grep "^Description:" "$METADATA_DIR/control" | cut -d' ' -f2- | tr -d '\r' | head -1)

    PKG_DEPENDS=""
    if [ -n "$PKG_DEPENDS_RAW" ]; then
        PKG_DEPENDS=$(echo "$PKG_DEPENDS_RAW" | sed 's/([^)]*)//g' | sed 's/, */,/g' | sed 's/ *$//')
    fi

    local PKG_DIR="$PACKAGES_DIR/$PKG_NAME"
    mkdir -p "$PKG_DIR"
    KPK_FILENAME="${PKG_NAME}-${PKG_VERSION}-${PKG_ARCH}.kpk"
    KPK_PATH="$PKG_DIR/$KPK_FILENAME"

    # Skip if already exists (dedupe)
    if [ -f "$KPK_PATH" ]; then
        echo -e "${YELLOW}   ⏭️  Already have $PKG_VERSION${NC}"
        rm -f "$DOWNLOAD_PATH"
        return 0
    fi

    echo -e "${GREEN}   📋 $PKG_NAME $PKG_VERSION${NC}"

    EXTRACT_DIR="$TEMP_DIR/build-$PKG_NAME-$PKG_VERSION"
    rm -rf "$EXTRACT_DIR"; mkdir -p "$EXTRACT_DIR"
    cp "$DOWNLOAD_PATH" "$EXTRACT_DIR/"
    ( cd "$EXTRACT_DIR" && ar x "$(basename "$DOWNLOAD_PATH")" ) || return 1

    for data_file in "$EXTRACT_DIR"/data.tar*; do
        [ -f "$data_file" ] || continue
        ( cd "$EXTRACT_DIR" && \
          case "$(basename "$data_file")" in
              *.gz)  tar -xzf "$(basename "$data_file")" ;;
              *.xz)  tar -xJf "$(basename "$data_file")" ;;
              *.zst) tar --use-compress-program=unzstd -xf "$(basename "$data_file")" ;;
              *)     tar -xf "$(basename "$data_file")" ;;
          esac ) || return 1
        rm -f "$data_file"
    done

    rm -f "$EXTRACT_DIR"/control.tar* "$EXTRACT_DIR/debian-binary"

    cat > "$EXTRACT_DIR/manifest.json" << MEOF
{
  "name": "$PKG_NAME",
  "version": "$PKG_VERSION",
  "arch": "$PKG_ARCH",
  "built_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
MEOF

    tar --use-compress-program=zstd -cf "$KPK_PATH" -C "$EXTRACT_DIR" .

    KPK_SIZE=$(stat -c%s "$KPK_PATH")
    echo -e "${GREEN}   ✅ $(numfmt --to=iec $KPK_SIZE)${NC}"

    rm -rf "$EXTRACT_DIR" "$DOWNLOAD_PATH"
    return 0
}

# ============================================================
# MAIN LOOP
# ============================================================
UPDATED=0; SKIPPED=0; FAILED=0; ARCHIVED=0; NEW_VERSIONS=0
UPDATED_PACKAGES=()

for PKG in "${PACKAGES[@]}"; do
    echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}🔷 $PKG${NC}"
    echo ""

    # Find ALL URLs for this package
    URLS=$("$FIND_URLS" "$PKG" 2>/dev/null || true)

    if [ -z "$URLS" ]; then
        echo -e "${RED}   ❌ Not found in any source${NC}"
        FAILED=$((FAILED + 1))
        continue
    fi

    URL_COUNT=$(echo "$URLS" | wc -l)
    echo -e "${CYAN}   Found $URL_COUNT URL(s)${NC}"

    PKG_GOT_NEW=0
    while IFS= read -r URL; do
        [ -z "$URL" ] && continue
        echo "$URL" >> "$SOURCES_TXT"

        if download_and_convert "$URL" "$PKG"; then
            # Check if this was a new version vs already-had
            FILENAME=$(basename "$URL")
            # (the download_and_convert already printed "Already have" if skipped)
            PKG_GOT_NEW=1
        fi
    done <<< "$URLS"

    # ============================================================
    # PRUNE — keep KEEP_VERSIONS newest per package
    # ============================================================
    PKG_DIR="$PACKAGES_DIR/$PKG"
    if [ -d "$PKG_DIR" ]; then
        # Get all .kpk files, sort by version (newest first)
        ALL_VERSIONS=$(find "$PKG_DIR" -name "${PKG}-*-arm64.kpk" -type f | sort -V -r)
        TOTAL=$(echo "$ALL_VERSIONS" | grep -c . || echo 0)

        if [ "$TOTAL" -gt "$KEEP_VERSIONS" ]; then
            TO_DELETE=$(echo "$ALL_VERSIONS" | tail -n +$((KEEP_VERSIONS + 1)))
            while IFS= read -r old_kpk; do
                [ -f "$old_kpk" ] || continue
                echo -e "${YELLOW}   🗑️  Pruned: $(basename "$old_kpk")${NC}"
                rm -f "$old_kpk"
                ARCHIVED=$((ARCHIVED + 1))
            done <<< "$TO_DELETE"
        fi
    fi

    # ============================================================
    # UPDATE INDEX.JSON FOR THIS PACKAGE
    # ============================================================
    python3 << PYEOF
import json, glob, os, hashlib
from datetime import datetime, UTC

with open('$INDEX_FILE') as f:
    index = json.load(f)
index.setdefault('packages', {})

pkg_dir = "$PKG_DIR"
pkg_name = "$PKG"

# Collect all versions present on disk
available = []
for kpk in glob.glob(f"{pkg_dir}/{pkg_name}-*-arm64.kpk"):
    base = os.path.basename(kpk)
    ver = base.replace(f"{pkg_name}-", "").replace("-arm64.kpk", "")
    h = hashlib.sha256()
    with open(kpk, 'rb') as fh:
        for chunk in iter(lambda: fh.read(8192), b''):
            h.update(chunk)
    available.append({
        'version': ver,
        'filename': f"packages/{pkg_name}/{base}",
        'sha256': h.hexdigest(),
        'size': os.path.getsize(kpk),
        'date_added': datetime.now(UTC).strftime('%Y-%m-%d'),
        'stable': True,
    })

if not available:
    print("__NO_VERSIONS__")
else:
    # Sort newest first by version tuple (handles 7.2-2build1 < 7.2-2build2)
    def vkey(v):
        s = v['version']
        parts = []
        for chunk in s.replace('~','.').split('.'):
            num = ''
            for c in chunk:
                if c.isdigit(): num += c
                else: break
            parts.append(int(num) if num else 0)
        return parts
    available.sort(key=vkey, reverse=True)

    # Take newest version as 'current'
    newest = available[0]
    index['packages'][pkg_name] = {
        'current': newest['version'],
        'arch': 'arm64',
        'description': (index['packages'].get(pkg_name, {}).get('description') or ''),
        'available_versions': available,
    }
    print("__OK__")
PYEOF

    RC=$?
    if [ $RC -ne 0 ]; then
        echo -e "${RED}   ❌ Index update failed${NC}"
        FAILED=$((FAILED + 1))
        continue
    fi

    # Count versions currently held
    HELD=$(find "$PKG_DIR" -name "${PKG}-*-arm64.kpk" -type f 2>/dev/null | wc -l)
    echo -e "${GREEN}   📚 $HELD version(s) in repo${NC}"

    UPDATED=$((UPDATED + 1))
    UPDATED_PACKAGES+=("$PKG ($HELD versions)")
    echo ""
done

# ============================================================
# FINALISE index.json timestamp
# ============================================================
python3 - << PYEOF
import json
from datetime import datetime, UTC
with open('$INDEX_FILE') as f:
    idx = json.load(f)
idx['generated'] = datetime.now(UTC).isoformat()
with open('$INDEX_FILE', 'w') as f:
    json.dump(idx, f, indent=2)
PYEOF

# ============================================================
# SUMMARY
# ============================================================
echo ""
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo -e "${PURPLE}  📊 Build Summary${NC}"
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "${GREEN}   ✅ Packages processed: $UPDATED${NC}"
echo -e "${RED}   ❌ Failed:             $FAILED${NC}"
echo -e "${CYAN}   📦 Pruned old versions: $ARCHIVED${NC}"
echo ""
if [ ${#UPDATED_PACKAGES[@]} -gt 0 ]; then
    echo -e "${CYAN}   Details:${NC}"
    for p in "${UPDATED_PACKAGES[@]}"; do
        echo -e "${CYAN}     • $p${NC}"
    done
    echo ""
fi

# ============================================================
# AUTO-PUSH
# ============================================================
if [ $UPDATED -gt 0 ]; then
    echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
    echo -e "${PURPLE}  🚀 Auto-Sync to GitHub${NC}"
    echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
    echo ""

    cd "$REPO_ROOT"

    [ ! -d ".git" ] && { git init; git branch -M main; }
    git remote get-url origin >/dev/null 2>&1 || git remote add origin "$GIT_URL"

    git add -A
    git commit -m "Auto-update: $UPDATED packages ($(date +%Y-%m-%d))" || true

    git fetch origin "$GIT_BRANCH" 2>/dev/null || true
    if git rev-parse --verify "origin/$GIT_BRANCH" >/dev/null 2>&1; then
        git merge "origin/$GIT_BRANCH" --no-edit -m "Auto-merge" 2>/dev/null || {
            echo -e "${YELLOW}   ⚠️  Merge conflict — keeping local${NC}"
            git merge --abort 2>/dev/null || true
            git checkout --ours . 2>/dev/null || true
            git add -A
            git commit -m "Resolved conflicts (kept local)" 2>/dev/null || true
        }
    fi

    git push --set-upstream origin "$GIT_BRANCH" 2>&1 | tail -3 || {
        echo -e "${YELLOW}   ⚠️  Retry after pull${NC}"
        git pull origin "$GIT_BRANCH" --no-rebase --no-edit 2>/dev/null || true
        git push origin "$GIT_BRANCH" 2>&1 | tail -3
    }

    echo -e "${GREEN}   ✅ Pushed${NC}"
fi

rm -rf "$TEMP_DIR"

echo ""
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}  ✅ King OS Repo Build Complete!${NC}"
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo ""
