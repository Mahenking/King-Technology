#!/bin/bash
# ============================================================
# 👑 King OS Repository Builder (v3 — Full Dep Resolution)
# ============================================================
# Features:
#   - Multi-source search (config/sources.conf)
#   - Recursive dependency resolution (Depends + Pre-Depends)
#   - Depth limit (config/repo.conf: DEP_MAX_DEPTH)
#   - Essential skip list (config/repo.conf: SKIP_DEPS)
#   - Version-aware retention (keep KEEP_VERSIONS newest)
#   - Flat package layout (packages/<name>/<name>-<ver>-<arch>.kpk)
#   - index.json with explicit / pulled_by metadata
#   - Auto-push to GitHub with safe merge
# ============================================================

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$REPO_ROOT/config/repo.conf"

[ ! -f "$CONFIG_FILE" ] && { echo "❌ config/repo.conf missing"; exit 1; }
source "$CONFIG_FILE"

SOURCES_TXT="$REPO_ROOT/sources.txt"
FIND_URLS="$REPO_ROOT/scraper/find-package-urls.sh"
METADATA_DIR="$TEMP_DIR/metadata"

# Fallbacks if config didn't set them
: "${KEEP_VERSIONS:=3}"
: "${DEP_MAX_DEPTH:=4}"
: "${DEP_FIELDS:=Depends,Pre-Depends}"
: "${SKIP_DEPS:=}"
: "${USE_COLORS:=true}"

RED=''; GREEN=''; YELLOW=''; BLUE=''; PURPLE=''; CYAN=''; NC=''
if [ "$USE_COLORS" = "true" ]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
    BLUE='\033[0;34m'; PURPLE='\033[0;35m'; CYAN='\033[0;36m'; NC='\033[0m'
fi

mkdir -p "$PACKAGES_DIR" "$TEMP_DIR"

echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo -e "${PURPLE}  👑 King OS Repository Builder v3${NC}"
echo -e "${PURPLE}  Depth=$DEP_MAX_DEPTH | Keep $KEEP_VERSIONS newest${NC}"
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo ""

for tool in python3 wget ar tar zstd git curl awk; do
    command -v $tool &> /dev/null || { echo -e "${RED}❌ Missing: $tool${NC}"; exit 1; }
done

[ -f "$PACKAGES_LIST" ] || { echo -e "${RED}❌ packages.txt not found${NC}"; exit 1; }
[ -x "$FIND_URLS" ]     || { echo -e "${RED}❌ $FIND_URLS not executable${NC}"; exit 1; }

# ============================================================
# Parse packages.txt (supports name or name@version)
# ============================================================
PACKAGES=()
while IFS= read -r line; do
    [[ "$line" =~ ^#.*$ ]] && continue
    [[ -z "${line// }" ]] && continue
    PACKAGES+=("$(echo "$line" | tr -d '[:space:]')")
done < "$PACKAGES_LIST"

echo -e "${CYAN}📦 ${#PACKAGES[@]} top-level package(s) in packages.txt${NC}"
echo ""

[ ${#PACKAGES[@]} -eq 0 ] && { echo -e "${YELLOW}⚠️  Empty packages.txt${NC}"; exit 0; }

[ ! -f "$INDEX_FILE" ] && echo '{"version":"1.0","generated":"","packages":{}}' > "$INDEX_FILE"

echo "# Auto-generated by king-repo-build.sh on $(date)" > "$SOURCES_TXT"

# ============================================================
# Helpers
# ============================================================
is_skipped() {
    local name="$1"
    [ -z "$SKIP_DEPS" ] && return 1
    for s in $SKIP_DEPS; do
        [ "$s" = "$name" ] && return 0
    done
    return 1
}

# Debian-style version sort (newest first). Uses Python's dpkg-aware compare.
sort_versions_desc() {
    python3 -c "
import sys
import re

def vkey(v):
    # Epoch
    epoch = 0
    if ':' in v:
        e, v = v.split(':', 1)
        try: epoch = int(e)
        except: epoch = 0
    # Upstream vs debian revision
    if '-' in v:
        upstream, revision = v.rsplit('-', 1)
    else:
        upstream, revision = v, ''
    # Natural sort on both parts
    def nat(s):
        return [int(c) if c.isdigit() else c.lower()
                for c in re.findall(r'\d+|\D+', s)]
    return (epoch, nat(upstream), nat(revision))

versions = [l.strip() for l in sys.stdin if l.strip()]
versions.sort(key=vkey, reverse=True)
for v in versions:
    print(v)
"
}

# Download .deb and extract control info.
# Prints: name|version|arch|depends|description on stdout.
# Returns 0 on success, 1 on failure.
fetch_control_info() {
    local url="$1"
    local fname download_dir
    fname=$(basename "$url")
    download_dir="$TEMP_DIR/ctrl-$fname"
    rm -rf "$download_dir"; mkdir -p "$download_dir"

    ( cd "$download_dir" && \
      wget -q -O "$fname" "$url" && \
      ar x "$fname" ) || return 1

    local ctrl_archive=""
    for f in "$download_dir"/control.tar*; do
        [ -f "$f" ] && ctrl_archive="$f" && break
    done
    [ -z "$ctrl_archive" ] && return 1

    ( cd "$download_dir" && \
      case "$ctrl_archive" in
          *.gz)  tar -xzf "$ctrl_archive" ;;
          *.xz)  tar -xJf "$ctrl_archive" ;;
          *.zst) tar --use-compress-program=unzstd -xf "$ctrl_archive" ;;
          *)     tar -xf "$ctrl_archive" ;;
      esac ) || return 1

    local ctrl="$download_dir/control"
    [ -f "$ctrl" ] || return 1

    local name version arch depends desc
    name=$(grep "^Package:" "$ctrl" | head -1 | cut -d' ' -f2- | tr -d '\r')
    version=$(grep "^Version:" "$ctrl" | head -1 | cut -d' ' -f2- | tr -d '\r')
    arch=$(grep "^Architecture:" "$ctrl" | head -1 | cut -d' ' -f2- | tr -d '\r')
    desc=$(grep "^Description:" "$ctrl" | head -1 | cut -d' ' -f2- | tr -d '\r')

    # Merge specified dep fields
    depends=""
    IFS=',' read -ra FIELDS <<< "$DEP_FIELDS"
    for field in "${FIELDS[@]}"; do
        field=$(echo "$field" | xargs)
        local d
        d=$(grep "^$field:" "$ctrl" | cut -d' ' -f2- | tr -d '\r' | tr '\n' ',' | sed 's/,$//')
        [ -n "$d" ] && depends="${depends:+$depends,}$d"
    done

    echo "${name}|${version}|${arch}|${depends}|${desc}"
    return 0
}

# Convert a .deb URL to .kpk, store under packages/<name>/
# Returns 0 on success, 1 on failure. Also records into new_packages log.
convert_to_kpk() {
    local url="$1"
    local fname download_dir kpk_name kpk_path
    local name version arch extract_dir

    fname=$(basename "$url")
    download_dir="$TEMP_DIR/conv-$fname"
    rm -rf "$download_dir"; mkdir -p "$download_dir"

    ( cd "$download_dir" && wget -q -O "$fname" "$url" && ar x "$fname" ) || return 1

    # Extract data
    local data_archive=""
    for f in "$download_dir"/data.tar*; do
        [ -f "$f" ] && data_archive="$f" && break
    done
    [ -z "$data_archive" ] && return 1

    extract_dir="$download_dir/data"
    mkdir -p "$extract_dir"
    ( cd "$extract_dir" && \
      case "$data_archive" in
          *.gz)  tar -xzf "$data_archive" ;;
          *.xz)  tar -xJf "$data_archive" ;;
          *.zst) tar --use-compress-program=unzstd -xf "$data_archive" ;;
          *)     tar -xf "$data_archive" ;;
      esac ) || return 1

    # Read control for name/version
    local ctrl_archive=""
    for f in "$download_dir"/control.tar*; do
        [ -f "$f" ] && ctrl_archive="$f" && break
    done
    [ -z "$ctrl_archive" ] && return 1

    ( cd "$download_dir" && \
      case "$ctrl_archive" in
          *.gz)  tar -xzf "$ctrl_archive" ;;
          *.xz)  tar -xJf "$ctrl_archive" ;;
          *.zst) tar --use-compress-program=unzstd -xf "$ctrl_archive" ;;
          *)     tar -xf "$ctrl_archive" ;;
      esac ) || return 1

    name=$(grep "^Package:" "$download_dir/control" | head -1 | cut -d' ' -f2- | tr -d '\r')
    version=$(grep "^Version:" "$download_dir/control" | head -1 | cut -d' ' -f2- | tr -d '\r')
    arch=$(grep "^Architecture:" "$download_dir/control" | head -1 | cut -d' ' -f2- | tr -d '\r')
    [ -z "$name" ] || [ -z "$version" ] || [ -z "$arch" ] && return 1

    mkdir -p "$PACKAGES_DIR/$name"
    kpk_name="${name}-${version}-${arch}.kpk"
    kpk_path="$PACKAGES_DIR/$name/$kpk_name"

    if [ -f "$kpk_path" ]; then
        echo "SKIP|$name|$version"
        rm -rf "$download_dir"
        return 0
    fi

    # Add manifest
    cat > "$extract_dir/manifest.json" << MEOF
{
  "name": "$name",
  "version": "$version",
  "arch": "$arch",
  "built_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
MEOF

    tar --use-compress-program=zstd -cf "$kpk_path" -C "$extract_dir" .

    local size
    size=$(stat -c%s "$kpk_path")
    echo "OK|$name|$version|$size"
    rm -rf "$download_dir"
    return 0
}

# ============================================================
# DEP RESOLUTION — returns "name version" for each top-level dep
# ============================================================
# Recursively walks deps. Prints "<name>@<version-or-empty>" one per line.
# Deduplicates. Respects depth + skip list.
resolve_deps_recursive() {
    local pkg="$1"
    local depth="$2"
    local visited_file="$3"

    [ "$depth" -ge "$DEP_MAX_DEPTH" ] && return 0

    # Get the .deb for this package
    local url url_list
    url_list=$("$FIND_URLS" "$pkg" 2>/dev/null || true)
    [ -z "$url_list" ] && return 0

    # Take the first URL (typically the newest from primary source)
    url=$(echo "$url_list" | head -1)

    # Fetch control info
    local cinfo
    cinfo=$(fetch_control_info "$url") || return 0
    [ -z "$cinfo" ] && return 0

    local name version arch depends desc
    IFS='|' read -r name version arch depends desc <<< "$cinfo"

    # Parse depends list
    [ -z "$depends" ] && return 0

    # Split by comma
    IFS=',' read -ra DEPS <<< "$depends"
    for raw in "${DEPS[@]}"; do
        # Strip version constraints: "libc6 (>= 2.38)" → "libc6"
        # Strip alternatives: "foo | bar" → "foo"
        local d
        d=$(echo "$raw" | sed 's/([^)]*)//g' | sed 's/|.*//' | xargs)
        [ -z "$d" ] && continue

        # Skip essential
        if is_skipped "$d"; then
            continue
        fi

        # Already visited?
        if grep -qxF "$d" "$visited_file" 2>/dev/null; then
            continue
        fi
        echo "$d" >> "$visited_file"

        # Emit this dep
        echo "$d"

        # Recurse
        resolve_deps_recursive "$d" $((depth + 1)) "$visited_file"
    done
}

# ============================================================
# BUILD LOOP
# ============================================================
UPDATED=0; FAILED=0; SKIPPED=0; PRUNED=0
NEW_EXPLICIT=0; NEW_AUTO=0

VISITED_FILE="$TEMP_DIR/visited.txt"
: > "$VISITED_FILE"

for RAW in "${PACKAGES[@]}"; do
    PKG_NAME="${RAW%@*}"
    PKG_VER=""
    [[ "$RAW" == *@* ]] && PKG_VER="${RAW#*@}"

    echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}🔷 $PKG_NAME${PKG_VER:+ @ $PKG_VER}${NC}"
    echo ""

    # Step 1: find URLs for this package
    echo -e "${BLUE}   🔍 Finding URLs...${NC}"
    URLS=$("$FIND_URLS" "$RAW" 2>/dev/null || true)
    if [ -z "$URLS" ]; then
        echo -e "${RED}   ❌ Not found in any source${NC}"
        FAILED=$((FAILED + 1))
        continue
    fi
    URL_COUNT=$(echo "$URLS" | grep -c .)
    echo -e "${GREEN}   ✅ $URL_COUNT URL(s)${NC}"

    # Step 2: convert each to .kpk
    while IFS= read -r url; do
        [ -z "$url" ] && continue
        echo "$url" >> "$SOURCES_TXT"
        res=$(convert_to_kpk "$url") || { echo -e "${RED}   ❌ convert failed: $url${NC}"; continue; }
        IFS='|' read -r status name ver size <<< "$res"
        case "$status" in
            SKIP) echo -e "${YELLOW}   ⏭️  $name $ver (already have)${NC}" ;;
            OK)   echo -e "${GREEN}   ✅ $name $ver ($(numfmt --to=iec ${size:-0}))${NC}"
                  NEW_EXPLICIT=$((NEW_EXPLICIT + 1)) ;;
        esac
    done <<< "$URLS"

    # Step 3: resolve deps (only if not pinned)
    if [ -z "$PKG_VER" ]; then
        echo -e "${BLUE}   🔗 Resolving deps (max depth $DEP_MAX_DEPTH)...${NC}"
        DEPS=$(resolve_deps_recursive "$PKG_NAME" 0 "$VISITED_FILE" 2>/dev/null || true)

        if [ -n "$DEPS" ]; then
            DEP_COUNT=$(echo "$DEPS" | grep -c .)
            echo -e "${CYAN}   📦 $DEP_COUNT dependency/dependencies to pull${NC}"

            while IFS= read -r dep; do
                [ -z "$dep" ] && continue
                if is_skipped "$dep"; then
                    echo -e "${YELLOW}   ⏭️  $dep (essential — skipped)${NC}"
                    continue
                fi

                dep_urls=$("$FIND_URLS" "$dep" 2>/dev/null || true)
                if [ -z "$dep_urls" ]; then
                    echo -e "${YELLOW}   ⚠️  $dep not found${NC}"
                    continue
                fi

                # Take newest version only (first URL)
                dep_url=$(echo "$dep_urls" | head -1)
                echo "$dep_url" >> "$SOURCES_TXT"

                res=$(convert_to_kpk "$dep_url") || continue
                IFS='|' read -r status name ver size <<< "$res"
                case "$status" in
                    SKIP) echo -e "${YELLOW}     ⏭️  $name $ver${NC}" ;;
                    OK)   echo -e "${GREEN}     ➕ $name $ver${NC}"
                          NEW_AUTO=$((NEW_AUTO + 1)) ;;
                esac
            done <<< "$DEPS"
        fi
    fi

    UPDATED=$((UPDATED + 1))
    echo ""
done

# ============================================================
# PRUNE — keep KEEP_VERSIONS per package
# ============================================================
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo -e "${PURPLE}  🗑️  Pruning old versions${NC}"
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo ""

for pkg_dir in "$PACKAGES_DIR"/*/; do
    [ -d "$pkg_dir" ] || continue
    pkg=$(basename "$pkg_dir")

    # Get all versions from filenames
    versions=$(find "$pkg_dir" -maxdepth 1 -name "${pkg}-*-arm64.kpk" -type f 2>/dev/null | \
               while read f; do
                   b=$(basename "$f")
                   echo "${b#${pkg}-}" | sed 's/-arm64.kpk$//'
               done)

    [ -z "$versions" ] && continue
    count=$(echo "$versions" | grep -c .)

    if [ "$count" -le "$KEEP_VERSIONS" ]; then
        continue
    fi

    # Sort newest first, drop the keepers, delete the rest
    keep=$(echo "$versions" | sort_versions_desc | head -n "$KEEP_VERSIONS")
    all=$(echo "$versions" | sort_versions_desc)

    to_delete=$(comm -23 <(echo "$all" | sort) <(echo "$keep" | sort))

    while IFS= read -r v; do
        [ -z "$v" ] && continue
        f="$pkg_dir/${pkg}-${v}-arm64.kpk"
        [ -f "$f" ] || continue
        echo -e "${YELLOW}   🗑️  $pkg $v${NC}"
        rm -f "$f"
        PRUNED=$((PRUNED + 1))
    done <<< "$to_delete"
done

# ============================================================
# REBUILD index.json
# ============================================================
echo ""
echo -e "${BLUE}📝 Rebuilding index.json...${NC}"


# Wait — Python needs env vars. Let's rerun properly.
KING_INDEX_FILE="$INDEX_FILE" \
KING_PACKAGES_DIR="$PACKAGES_DIR" \
KING_PACKAGES_LIST="$PACKAGES_LIST" \
python3 << 'PYEOF'
import json, glob, os, hashlib, re
from datetime import datetime, UTC

INDEX = os.environ["KING_INDEX_FILE"]
PACKAGES_DIR = os.environ["KING_PACKAGES_DIR"]
PACKAGES_TXT = os.environ["KING_PACKAGES_LIST"]

idx = {"version": "1.0", "generated": "", "packages": {}}
if os.path.exists(INDEX):
    try:
        with open(INDEX) as f:
            idx = json.load(f)
    except Exception:
        pass
idx.setdefault("packages", {})

explicit_names = set()
if os.path.exists(PACKAGES_TXT):
    with open(PACKAGES_TXT) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            explicit_names.add(line.split("@")[0].strip())

def nat(t):
    return [int(c) if c.isdigit() else c.lower()
            for c in re.findall(r'\d+|\D+', t)]

def vkey(s):
    epoch = 0
    if ':' in s:
        e, s = s.split(':', 1)
        try: epoch = int(e)
        except: epoch = 0
    if '-' in s:
        up, rev = s.rsplit('-', 1)
    else:
        up, rev = s, ''
    return (epoch, nat(up), nat(rev))

packages = {}
for pkg_dir in glob.glob(f"{PACKAGES_DIR}/*/"):
    name = os.path.basename(pkg_dir.rstrip("/"))
    versions = []
    for kpk in glob.glob(f"{pkg_dir}{name}-*-arm64.kpk"):
        base = os.path.basename(kpk)
        ver = base.replace(f"{name}-", "").replace("-arm64.kpk", "")
        h = hashlib.sha256()
        with open(kpk, 'rb') as fh:
            for chunk in iter(lambda: fh.read(65536), b''):
                h.update(chunk)
        versions.append({
            "version": ver,
            "filename": f"packages/{name}/{base}",
            "sha256": h.hexdigest(),
            "size": os.path.getsize(kpk),
            "date_added": datetime.now(UTC).strftime("%Y-%m-%d"),
        })
    if not versions:
        continue
    versions.sort(key=lambda v: vkey(v["version"]), reverse=True)

    old = idx["packages"].get(name, {})
    packages[name] = {
        "current": versions[0]["version"],
        "arch": "arm64",
        "description": old.get("description", ""),
        "depends": old.get("depends", []),
        "explicit": name in explicit_names,
        "available_versions": versions,
    }

idx["packages"] = packages
idx["generated"] = datetime.now(UTC).isoformat()

with open(INDEX, "w") as f:
    json.dump(idx, f, indent=2)
PYEOF

# ============================================================
# SUMMARY
# ============================================================
echo ""
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo -e "${PURPLE}  📊 Build Summary${NC}"
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "${GREEN}   ✅ Top-level processed: $UPDATED${NC}"
echo -e "${GREEN}   ➕ Auto-pulled deps:    $NEW_AUTO${NC}"
echo -e "${YELLOW}   🗑️  Pruned versions:    $PRUNED${NC}"
echo -e "${RED}   ❌ Failed:              $FAILED${NC}"
echo ""

TOTAL_PKGS=$(ls -d "$PACKAGES_DIR"/*/ 2>/dev/null | wc -l)
TOTAL_SIZE=$(du -sh "$PACKAGES_DIR" 2>/dev/null | cut -f1)
echo -e "${CYAN}   📦 Repo: $TOTAL_PKGS packages, $TOTAL_SIZE${NC}"
echo ""

# ============================================================
# AUTO-PUSH
# ============================================================
if [ "$UPDATED" -gt 0 ] || [ "$NEW_AUTO" -gt 0 ] || [ "$PRUNED" -gt 0 ]; then
    echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
    echo -e "${PURPLE}  🚀 Auto-Sync to GitHub${NC}"
    echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
    echo ""

    cd "$REPO_ROOT"

    [ ! -d ".git" ] && { git init; git branch -M main; }
    git remote get-url origin >/dev/null 2>&1 || git remote add origin "$GIT_URL"

    git add -A
    git commit -m "Auto-update: $UPDATED top + $NEW_AUTO deps + $PRUNED pruned ($(date +%Y-%m-%d))" || true

    git fetch origin "$GIT_BRANCH" 2>/dev/null || true
    if git rev-parse --verify "origin/$GIT_BRANCH" >/dev/null 2>&1; then
        git merge "origin/$GIT_BRANCH" --no-edit -m "Auto-merge" 2>/dev/null || {
            echo -e "${YELLOW}   ⚠️  Merge conflict — keeping local${NC}"
            git merge --abort 2>/dev/null || true
            git checkout --ours . 2>/dev/null || true
            git add -A
            git commit -m "Resolved conflicts (kept local)" 2>/dev/null || true
        }
    fi

    git push --set-upstream origin "$GIT_BRANCH" 2>&1 | tail -3 || {
        echo -e "${YELLOW}   ⚠️  Retry after pull${NC}"
        git pull origin "$GIT_BRANCH" --no-rebase --no-edit 2>/dev/null || true
        git push origin "$GIT_BRANCH" 2>&1 | tail -3
    }
    echo -e "${GREEN}   ✅ Pushed${NC}"
fi

rm -rf "$TEMP_DIR"

echo ""
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}  ✅ Build Complete${NC}"
echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
echo ""
